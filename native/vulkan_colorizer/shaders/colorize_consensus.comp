#version 450
layout(local_size_x = 256) in;

layout(std140, set = 0, binding = 0) uniform CameraUBO {
    mat4 R_cw;          // 64 bytes: Rotation world -> camera (col-major)
    vec4 C_world;       // 16 bytes: Optical center (xyz)
    vec4 intrinsics1;   // 16 bytes: fx, fy, cx, cy
    vec4 dist_radial;   // 16 bytes: k1, k2, k3, k4
    vec4 dist_prism;    // 16 bytes: p1, p2, sx1, sy1
    ivec2 zbuf_size;    // 8 bytes:  width, height (e.g. 960, 960)
    vec2 zbuf_scale;    // 8 bytes:  3840.0 / width, 3840.0 / height
    float min_z;        // 4 bytes:  0.15
    float max_radius;   // 4 bytes:  1620.0
    uint num_points;    // 4 bytes:  total points
    uint pad0;          // 4 bytes
    vec4 log_gain;      // RGB log exposure / white balance; w enables correction
    vec4 vignette;      // achromatic k1, k2, k3 for r^2, r^4, r^6
    vec4 ppisp_h[3];    // row-major 3x3; row0.w enables the advanced path
    vec4 bilateral_grid[36]; // [depth=4,height=3,width=3,RGB], one vec4 per cell
};

struct Point3D {
    float x, y, z;
    float intensity;
};

layout(std430, set = 0, binding = 1) readonly buffer PointsIn {
    Point3D points[];
};

layout(std430, set = 0, binding = 2) readonly buffer DepthMap {
    uint depth_grid[];
};

layout(set = 0, binding = 3) uniform sampler2D cameraTexture;

layout(std430, set = 0, binding = 4) buffer TopScores {
    vec4 scores[]; // .xyz = top 3 scores, .w = valid view count
};

layout(std430, set = 0, binding = 5) buffer TopColors {
    uvec4 colors[]; // .x = color1, .y = color2, .z = color3 (each packed RGB8)
};

vec3 srgb_to_linear(vec3 c) {
    bvec3 low = lessThanEqual(c, vec3(0.04045));
    vec3 high = pow((c + vec3(0.055)) / 1.055, vec3(2.4));
    return mix(high, c / 12.92, low);
}

vec3 linear_to_srgb(vec3 c) {
    c = max(c, vec3(0.0));
    bvec3 low = lessThanEqual(c, vec3(0.0031308));
    vec3 high = 1.055 * pow(c, vec3(1.0 / 2.4)) - vec3(0.055);
    return mix(high, 12.92 * c, low);
}

vec3 sample_bilateral_grid(vec3 coordinate) {
    // Grid memory order is [D,H,W,RGB], matching the fitted NumPy tensor.
    vec3 p = clamp(coordinate, vec3(0.0), vec3(1.0)) * vec3(2.0, 2.0, 3.0);
    ivec3 lo = ivec3(floor(p));
    ivec3 hi = min(lo + ivec3(1), ivec3(2, 2, 3));
    vec3 f = p - vec3(lo);
    vec3 result = vec3(0.0);
    for (int dz = 0; dz <= 1; ++dz) {
        int z = dz == 0 ? lo.z : hi.z;
        float wz = dz == 0 ? 1.0 - f.z : f.z;
        for (int dy = 0; dy <= 1; ++dy) {
            int y = dy == 0 ? lo.y : hi.y;
            float wy = dy == 0 ? 1.0 - f.y : f.y;
            for (int dx = 0; dx <= 1; ++dx) {
                int x = dx == 0 ? lo.x : hi.x;
                float wx = dx == 0 ? 1.0 - f.x : f.x;
                int index = (z * 3 + y) * 3 + x;
                result += bilateral_grid[index].rgb * (wx * wy * wz);
            }
        }
    }
    return result;
}

vec3 apply_ppisp_homography(vec3 rgb) {
    float total = rgb.r + rgb.g + rgb.b;
    vec3 input_chroma = vec3(rgb.r, rgb.g, total);
    vec3 transformed = vec3(dot(ppisp_h[0].xyz, input_chroma),
                            dot(ppisp_h[1].xyz, input_chroma),
                            dot(ppisp_h[2].xyz, input_chroma));
    float denominator = max(transformed.z, 1e-4 * abs(total) + 1e-8);
    float scale = total / denominator;
    float red = transformed.x * scale;
    float green = transformed.y * scale;
    return clamp(vec3(red, green, total - red - green), vec3(0.0), vec3(1.0));
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= num_points) return;

    vec3 P_world = vec3(points[idx].x, points[idx].y, points[idx].z);
    vec3 diff = P_world - C_world.xyz;
    vec3 P_cam = (R_cw * vec4(diff, 0.0)).xyz;

    if (P_cam.z <= min_z) return;

    float d = length(P_cam);
    float x = P_cam.x / P_cam.z;
    float y = P_cam.y / P_cam.z;
    float r = sqrt(x * x + y * y);
    if (r < 1e-8) r = 1e-8;

    bool perspective_model = dist_prism.w < -997.0;
    float rd2;
    float x_pp;
    float y_pp;
    if (perspective_model) {
        rd2 = x * x + y * y;
        float radial = 1.0 + rd2 * (dist_radial.x + rd2 * (dist_radial.y + rd2 * (dist_radial.z + rd2 * dist_radial.w)));
        x_pp = x * radial + 2.0 * dist_prism.x * x * y + dist_prism.y * (rd2 + 2.0 * x * x);
        y_pp = y * radial + dist_prism.x * (rd2 + 2.0 * y * y) + 2.0 * dist_prism.y * x * y;
    } else {
        float th = atan(r);
        float th2 = th * th;
        float th4 = th2 * th2;
        float th6 = th4 * th2;
        float th8 = th4 * th4;
        float thd = th * (1.0 + dist_radial.x * th2 + dist_radial.y * th4 + dist_radial.z * th6 + dist_radial.w * th8);
        float scale = th / r;
        float xd = x * scale;
        float yd = y * scale;
        rd2 = xd * xd + yd * yd;
        x_pp = xd * (th > 1e-8 ? thd / th : 1.0) + 2.0 * dist_prism.x * xd * yd + dist_prism.y * (rd2 + 2.0 * xd * xd) + dist_prism.z * rd2;
        y_pp = yd * (th > 1e-8 ? thd / th : 1.0) + dist_prism.x * (rd2 + 2.0 * yd * yd) + 2.0 * dist_prism.y * xd * yd + dist_prism.w * rd2;
    }

    float u = intrinsics1.x * x_pp + intrinsics1.z;
    float v = intrinsics1.y * y_pp + intrinsics1.w;

    vec2 uv = vec2(u, v);
    float r_px = distance(uv, intrinsics1.zw);

    if (r_px >= max_radius || u < 0.0 || u >= zbuf_scale.x * float(zbuf_size.x) - 1.0 || v < 0.0 || v >= zbuf_scale.y * float(zbuf_size.y) - 1.0) return;

    // Reject all four bilinear taps if any touches an excluded person pixel.
    // Unmasked RVC1 images have alpha 1 everywhere.
    ivec2 pixel = ivec2(floor(uv));
    if (texelFetch(cameraTexture, pixel, 0).a < 1.0 ||
        texelFetch(cameraTexture, pixel + ivec2(1, 0), 0).a < 1.0 ||
        texelFetch(cameraTexture, pixel + ivec2(0, 1), 0).a < 1.0 ||
        texelFetch(cameraTexture, pixel + ivec2(1, 1), 0).a < 1.0) return;

    // 1. Occlusion Check against Z-Buffer
    int ug = clamp(int(floor(u / zbuf_scale.x)), 0, zbuf_size.x - 1);
    int vg = clamp(int(floor(v / zbuf_scale.y)), 0, zbuf_size.y - 1);

    // Use the nearest valid sample in a 3x3 neighborhood.  The depth pass
    // can leave sparse holes when a foreground surface lands between cells.
    uint nearest_depth_fixed = 0xffffffffu;
    for (int dy = -1; dy <= 1; ++dy) {
        int ny = vg + dy;
        if (ny < 0 || ny >= zbuf_size.y) continue;
        for (int dx = -1; dx <= 1; ++dx) {
            int nx = ug + dx;
            if (nx < 0 || nx >= zbuf_size.x) continue;
            uint candidate = depth_grid[ny * zbuf_size.x + nx];
            if (candidate < nearest_depth_fixed) nearest_depth_fixed = candidate;
        }
    }
    if (nearest_depth_fixed == 0xffffffffu) return;
    float nearest_d = float(nearest_depth_fixed) / 1000.0;
    float visibility_tolerance = max(0.03, 0.01 * nearest_d);
    if (d > nearest_d + visibility_tolerance) return;

    // 2. Score calculation: favors closer and center-of-lens rays
    float norm_r = r_px / max_radius;
    float angle_weight = 1.0 - 0.5 * norm_r * norm_r;
    float dist_weight = pow(max(d, 0.5), 1.5);
    float score = angle_weight / dist_weight;

    // 3. Top-3 Consensus Slot Insertion
    vec3 cur_scores = scores[idx].xyz;
    float min_top = min(cur_scores.x, min(cur_scores.y, cur_scores.z));

    if (score > min_top) {
        // Hardware bilinear texture sampling
        vec2 norm_uv = vec2((u + 0.5) / (zbuf_scale.x * float(zbuf_size.x)), (v + 0.5) / (zbuf_scale.y * float(zbuf_size.y)));
        vec3 sampled_rgb = texture(cameraTexture, norm_uv).rgb;

        // RVC1/RVC2 and zero-coefficient RVC3 retain the original exact path.
        // Correct each sampled observation in linear sRGB without rewriting
        // or keeping a second copy of the source image.
        bool apply_base = log_gain.w > 0.5;
        bool apply_advanced = ppisp_h[0].w > 0.5;
        if (apply_base || apply_advanced) {
            vec3 linear_rgb = srgb_to_linear(sampled_rgb);
            if (apply_base) {
                float r_px_norm = r_px / 1620.0;
                float r2 = r_px_norm * r_px_norm;
                float r4 = r2 * r2;
                float r6 = r4 * r2;
                float vignette_log = vignette.x * r2 + vignette.y * r4 + vignette.z * r6;
                vec3 log_correction = clamp(log_gain.xyz + vec3(vignette_log),
                                            vec3(-0.693147181), vec3(0.693147181));
                linear_rgb *= exp(-log_correction);
            }
            // PPISP homography and the compact bilateral grid are evaluated
            // in linear sRGB before a single final sRGB encoding.
            if (apply_advanced) {
                linear_rgb = clamp(linear_rgb, vec3(0.0), vec3(1.0));
                linear_rgb = apply_ppisp_homography(linear_rgb);
                float luminance = dot(linear_rgb, vec3(0.2126, 0.7152, 0.0722));
                vec3 grid_log_gain = sample_bilateral_grid(vec3(
                    u / 3840.0,
                    v / 3840.0,
                    luminance));
                linear_rgb *= exp(clamp(grid_log_gain, vec3(-0.35), vec3(0.35)));
            }
            sampled_rgb = linear_to_srgb(linear_rgb);
        }

        uint r_u8 = uint(clamp(sampled_rgb.r * 255.0, 0.0, 255.0));
        uint g_u8 = uint(clamp(sampled_rgb.g * 255.0, 0.0, 255.0));
        uint b_u8 = uint(clamp(sampled_rgb.b * 255.0, 0.0, 255.0));
        uint packed_rgb = r_u8 | (g_u8 << 8) | (b_u8 << 16);

        // Replace the worst slot
        if (cur_scores.x <= cur_scores.y && cur_scores.x <= cur_scores.z) {
            scores[idx].x = score;
            colors[idx].x = packed_rgb;
        } else if (cur_scores.y <= cur_scores.x && cur_scores.y <= cur_scores.z) {
            scores[idx].y = score;
            colors[idx].y = packed_rgb;
        } else {
            scores[idx].z = score;
            colors[idx].z = packed_rgb;
        }
        scores[idx].w += 1.0;
    }
}
