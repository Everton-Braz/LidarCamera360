#version 450
#extension GL_GOOGLE_include_directive : require
#include "graph_common.glsl"
layout(local_size_x=256) in;
shared float sums[256];
shared float center;
void reduction() {
    barrier();
    for(uint s=128;s>0;s>>=1) {
        if(gl_LocalInvocationID.x<s) sums[gl_LocalInvocationID.x]+=sums[gl_LocalInvocationID.x+s];
        barrier();
    }
}
void main() {
    int row=int(gl_WorkGroupID.x),lane=int(gl_LocalInvocationID.x),n=a(0);
    int base=t(0,0)+row*n,outbase=p(1)+row*n;
    if(p(0)==36) {
        float v=-3.402823e38;
        for(int j=lane;j<n;j+=256) v=max(v,data[base+j]);
        sums[lane]=v; barrier();
        for(int s=128;s>0;s>>=1) { if(lane<s) sums[lane]=max(sums[lane],sums[lane+s]); barrier(); }
        float maxval=sums[0]; barrier();
        v=0.0;
        for(int j=lane;j<n;j+=256) { float x=exp(data[base+j]-maxval); data[outbase+j]=x; v+=x; }
        sums[lane]=v; reduction();
        float total=sums[0];
        for(int j=lane;j<n;j+=256) data[outbase+j]/=total;
    } else {
        float v=0.0;
        for(int j=lane;j<n;j+=256) v+=data[base+j];
        sums[lane]=v; reduction();
        if(lane==0) center=sums[0]/float(n);
        barrier(); v=0.0;
        for(int j=lane;j<n;j+=256) { float x=data[base+j]-center; v+=x*x; }
        sums[lane]=v; reduction();
        float inv=inversesqrt(sums[0]/float(n)+af(1));
        for(int j=lane;j<n;j+=256)
            data[outbase+j]=(data[base+j]-center)*inv*data[t(1,0)+j]+(p(22)>2 ? data[t(2,0)+j] : 0.0);
    }
}
