#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer InputBuffer { float input_values[]; };
layout(set = 0, binding = 1, std430) writeonly buffer OutputBuffer { float output_values[]; };
layout(push_constant) uniform Shape { uint rows; uint columns; } shape;

shared float reduction[256];

void main() {
    const uint row = gl_WorkGroupID.x;
    const uint lane = gl_LocalInvocationID.x;
    if (row >= shape.rows || shape.columns == 0) return;

    const uint base = row * shape.columns;
    float local_max = -3.402823e+38;
    for (uint column = lane; column < shape.columns; column += gl_WorkGroupSize.x)
        local_max = max(local_max, input_values[base + column]);

    reduction[lane] = local_max;
    barrier();
    for (uint stride = gl_WorkGroupSize.x >> 1; stride > 0; stride >>= 1) {
        if (lane < stride) reduction[lane] = max(reduction[lane], reduction[lane + stride]);
        barrier();
    }
    const float row_max = reduction[0];

    float local_sum = 0.0;
    for (uint column = lane; column < shape.columns; column += gl_WorkGroupSize.x) {
        const uint index = base + column;
        const float value = exp(input_values[index] - row_max);
        output_values[index] = value;
        local_sum += value;
    }

    reduction[lane] = local_sum;
    barrier();
    for (uint stride = gl_WorkGroupSize.x >> 1; stride > 0; stride >>= 1) {
        if (lane < stride) reduction[lane] += reduction[lane + stride];
        barrier();
    }

    const float inverse_sum = 1.0 / reduction[0];
    for (uint column = lane; column < shape.columns; column += gl_WorkGroupSize.x)
        output_values[base + column] *= inverse_sum;
}
