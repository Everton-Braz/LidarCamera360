-	const T x2(p.x() * p.x());
-	const T y2(p.y() * p.y());
-	const T xy(p.x() * p.y());
-	const T r2(x2 + y2);
-	const T r4(r2 * r2);
-	const T r6(r4 * r2);
-	typedef typename ScalarOf<T>::type S;
-	const T radial((S(1) + k1*r2 + k2*r4 + k3*r6) / (S(1) + k4*r2 + k5*r4 + k6*r6));
