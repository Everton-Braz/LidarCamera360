+IMAGEPTR Image::OpenImage(const String &fileName)
+{
+	return IMAGEPTR(CImage::Create(fileName, CImage::READ));
+} // OpenImage
+
+IMAGEPTR Image::ReadImageHeader(const String& fileName)
+{
+	IMAGEPTR pImage(OpenImage(fileName));
+	if (pImage == NULL || !pImage->ReadHeader()) {
+		LOG("error: failed loading image header");
+		pImage.Release();
+	}
+	return pImage;
+} // ReadImageHeader
+
+IMAGEPTR Image::ReadImage(const String& fileName, Image8U3& image)
+{
+	IMAGEPTR pImage(OpenImage(fileName));
+	if (pImage != NULL && !ReadImage(pImage, image))
+		pImage.Release();
+	return pImage;
+} // ReadImage
+
+bool Image::ReadImage(IMAGEPTR pImage, Image8U3& image)
+{
+	if (!pImage->ReadHeader()) {
+		LOG("error: failed loading image header");
+		return false;
+	}
+	image.create(pImage->GetHeight(), pImage->GetWidth());
+	if (!pImage->ReadData(image.data, PF_R8G8B8, 3, (CImage::Size)image.step)) {
+		LOG("error: failed loading image data");
+		return false;
+	}
+	return true;
+} // ReadImage
+
+IMAGEPTR Image::ReadPixels(const PlatformArr& platforms, Image8U3& pixels) const
+{
+	IMAGEPTR pImage(ReadImage(name, pixels));
+	if (pImage == NULL || !IsUndistortedOnRead())
+		return pImage;
+	const CameraLens& lens = GetLens(platforms);
+	if (pixels.size() != lens.size) {
+		LOG("error: image '%s' is %dx%d, its camera %dx%d", name.c_str(), pixels.width(), pixels.height(), lens.size.width, lens.size.height);
+		pImage.Release();
+		return pImage;
+	}
+	Image8U3 distorted;
+	cv::swap(distorted, pixels);
+	GetUndistortMaps(platforms)->Remap(distorted, pixels, cv::INTER_LINEAR);
+	return pImage;
+} // ReadPixels
+
+bool Image::LoadMask(const PlatformArr& platforms, Image8U& mask) const
+{
+	if (!mask.Load(GetMaskFileName()))
+		return false;
+	if (!IsUndistortedOnRead())
+		return true;
+	const CameraLens& lens = GetLens(platforms);
+	// the mask may be stored at another resolution than the image file
+	if (mask.size() != lens.size)
+		cv::resize(mask, mask, lens.size, 0, 0, cv::INTER_NEAREST);
+	Image8U distorted;
+	cv::swap(distorted, mask);
+	GetUndistortMaps(platforms)->Remap(distorted, mask, cv::INTER_NEAREST);
+	return true;
