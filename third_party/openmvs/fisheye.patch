+std::shared_ptr<const CameraUndistortMaps> Image::GetUndistortMaps(const PlatformArr& platforms) const
+{
+	const CameraLens& lens = GetLens(platforms);
+	return GetCameraUndistortMaps(lens.K, lens.distortion, lens.size);
