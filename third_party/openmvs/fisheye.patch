+#define __SEACAVE_CAMERAMODELS_H__
+
+
+// I N C L U D E S /////////////////////////////////////////////////
+
+#include <cmath>
+#include <cstdint>
+
+
+// D E F I N E S ///////////////////////////////////////////////////
+
+namespace ceres { template <typename T, int N> struct Jet; }
+
+
+namespace SEACAVE {
+
+// S T R U C T S ///////////////////////////////////////////////////
+
+// Camera projection models shared by host code, CUDA device code and Ceres (T = ceres::Jet).
+// The including context provides Eigen, ASSERT and HOST_DEVICE (Common.h, or CUDA/Maths.h in .cu files).
+// Conventions, common to all models:
+//  - pixel centers lie at integer coordinates (OpenCV/MVS): pixel (0,0) covers [-0.5,0.5]^2;
+//  - camera frame x-right, y-down, z-forward;
+//  - Ray(x) is the camera-space direction of pixel x, Project(X, x) its inverse (returns
+//    whether X is visible), ProjectFast(X, x) the same for single precision hot loops, and
+//    Depth(X) the distance along the ray that Ray(x) scales;
+//  - RayFrame(x) maps pixel offsets (dx,dy,1) around x to rays (columns: the ray derivatives
+//    along x and y, then Ray(x)), PixelHomography(r) maps rays near r to homogeneous pixels;
+//    the plane-induced patch warp between two views is composed from these two.
+
+// the plain scalar of T: T itself, or the value type of a Ceres Jet; the constants of the models that
+// Ceres differentiates are written in it, so that a Jet is offset or scaled by a scalar instead of
+// combined with a constant Jet (a full Jet operation per constant in the bundle adjustment)
+template<typename T> struct ScalarOf { typedef T type; };
+template<typename T, int N> struct ScalarOf<ceres::Jet<T,N>> { typedef T type; };
+
+// atan2 in single precision by a minimax polynomial of atan on [0,1] (max error 1.3e-7 rad, the
+// precision of the float atan2), several times cheaper than the library atan2 on the CPU and the GPU;
+// the CPU packet version (DepthMap.cpp) evaluates the same polynomial lane by lane
+HOST_DEVICE FORCEINLINE float FastAtan2(float y, float x) {
+	const float ax(x < 0.f ? -x : x), ay(y < 0.f ? -y : y);
+	const float mx(ax > ay ? ax : ay);
+	if (mx == 0.f)
+		return 0.f;
+	const float a((ax < ay ? ax : ay)/mx), s(a*a);
+	float r((((((((-0.0040540580f*s + 0.0218612288f)*s - 0.0559098861f)*s + 0.0964200441f)*s - 0.1390853351f)*s + 0.1994653599f)*s - 0.3332985605f)*s + 0.9999993329f)*a);
+	if (ay > ax)
+		r = float(3.14159265358979323846/2) - r;
+	if (x < 0.f)
+		r = float(3.14159265358979323846) - r;
+	return y < 0.f ? -r : r;
+}
+
+// model ids, stored in the scene files
+enum class CameraModelType : uint8_t {
+	PINHOLE = 0,
+	BROWN = 1, // pinhole + BrownDistortion
+	SPHERICAL = 2, // equidistant fisheye (LidarCamera360 fork)
+};
+
+// skew-free pinhole; Ray(x) lies on the z=1 plane, so the depth along it is z
+template<typename T>
+struct Pinhole {
+	typedef T Scalar;
+	typedef Eigen::Matrix<T,2,1> Vec2;
+	typedef Eigen::Matrix<T,3,1> Vec3;
+	typedef Eigen::Matrix<T,3,3> Mat3;
+
+	T fx, fy; // focal lengths in pixels
+	T cx, cy; // principal point in pixels
+
+	// pixel -> normalized image-plane coordinates (z=1)
+	HOST_DEVICE Vec2 PixelToNormalized(const Vec2& x) const {
+		ASSERT(fx > T(0) && fy > T(0));
+		return Vec2((x.x() - cx) / fx, (x.y() - cy) / fy);
+	}
+	// normalized image-plane coordinates -> pixel
+	HOST_DEVICE Vec2 NormalizedToPixel(const Vec2& n) const {
+		return Vec2(fx * n.x() + cx, fy * n.y() + cy);
+	}
+	// camera-space point -> normalized image-plane coordinates
+	HOST_DEVICE static FORCEINLINE Vec2 Perspective(const Vec3& X) {
+		const T invZ(typename ScalarOf<T>::type(1) / X.z());
+		return Vec2(X.x() * invZ, X.y() * invZ);
+	}
+
+	HOST_DEVICE Vec3 Ray(const Vec2& x) const {
+		const Vec2 n(PixelToNormalized(x));
+		return Vec3(n.x(), n.y(), T(1));
+	}
+	HOST_DEVICE bool Project(const Vec3& X, Vec2& x) const {
+		x = NormalizedToPixel(Perspective(X));
+		return X.z() > T(0);
+	}
+	HOST_DEVICE FORCEINLINE bool ProjectFast(const Vec3& X, Vec2& x) const {
+		return Project(X, x);
+	}
+	HOST_DEVICE static T Depth(const Vec3& X) {
+		return X.z();
+	}
+
+	// pixel offsets (dx,dy,1) around x -> rays: Ray(x+d) = RayFrame(x)*(dx,dy,1), exact for a pinhole
+	HOST_DEVICE Mat3 RayFrame(const Vec2& x) const {
+		const Vec3 r(Ray(x));
+		Mat3 F;
+		F << T(1)/fx, T(0), r.x(),
+		     T(0), T(1)/fy, r.y(),
+		     T(0), T(0), T(1);
+		return F;
+	}
+	// rays near the given one -> homogeneous pixels, exact for a pinhole: K
+	HOST_DEVICE Mat3 PixelHomography(const Vec3& /*ray*/) const {
+		Mat3 K;
+		K << fx, T(0), cx,
+		     T(0), fy, cy,
+		     T(0), T(0), T(1);
+		return K;
+	}
+};
+/*----------------------------------------------------------------*/
+
+
+// Brown-Conrady lens distortion on normalized image-plane coordinates, OpenCV coefficient order
+// and meaning: radial (1+k1*r2+k2*r4+k3*r6)/(1+k4*r2+k5*r4+k6*r6), tangential p1, p2;
+// the rational part k4..k6 is zero for the plain polynomial model
+template<typename T>
+HOST_DEVICE FORCEINLINE Eigen::Matrix<T,2,1> DistortBrown(const Eigen::Matrix<T,2,1>& p,
+	const T& k1, const T& k2, const T& p1, const T& p2, const T& k3, const T& k4, const T& k5, const T& k6)
+{
+	const T x2(p.x() * p.x());
+	const T y2(p.y() * p.y());
+	const T xy(p.x() * p.y());
+	const T r2(x2 + y2);
+	const T r4(r2 * r2);
+	const T r6(r4 * r2);
+	typedef typename ScalarOf<T>::type S;
+	const T radial((S(1) + k1*r2 + k2*r4 + k3*r6) / (S(1) + k4*r2 + k5*r4 + k6*r6));
+	return Eigen::Matrix<T,2,1>(
+		p.x() * radial + (S(2)*p1*xy + p2*(r2 + S(2)*x2)),
+		p.y() * radial + (p1*(r2 + S(2)*y2) + S(2)*p2*xy));
+}
+
+template<typename T>
+struct BrownDistortion {
+	typedef Eigen::Matrix<T,2,1> Vec2;
+
+	T k1, k2, p1, p2, k3, k4, k5, k6;
+
+	HOST_DEVICE bool IsZero() const {
+		return k1 == T(0) && k2 == T(0) && p1 == T(0) && p2 == T(0) && k3 == T(0) && k4 == T(0) && k5 == T(0) && k6 == T(0);
+	}
+
+	// undistorted -> distorted normalized coordinates
+	HOST_DEVICE Vec2 Distort(const Vec2& p) const {
+		return DistortBrown(p, k1, k2, p1, p2, k3, k4, k5, k6);
+	}
+	// Jacobian of Distort at p
+	HOST_DEVICE Eigen::Matrix<T,2,2> Jacobian(const Vec2& p) const {
+		const T x2(p.x() * p.x());
+		const T y2(p.y() * p.y());
+		const T xy(p.x() * p.y());
+		const T r2(x2 + y2);
+		const T r4(r2 * r2);
+		const T num(T(1) + k1*r2 + k2*r4 + k3*r4*r2);
+		const T invDen(T(1) / (T(1) + k4*r2 + k5*r4 + k6*r4*r2));
+		const T radial(num * invDen);
+		// d(radial)/d(r2) * 2
+		const T dRadial(T(2) * ((k1 + T(2)*k2*r2 + T(3)*k3*r4) - radial * (k4 + T(2)*k5*r2 + T(3)*k6*r4)) * invDen);
+		Eigen::Matrix<T,2,2> J;
+		J(0,0) = radial + dRadial*x2 + T(2)*p1*p.y() + T(6)*p2*p.x();
+		J(0,1) = dRadial*xy + T(2)*p1*p.x() + T(2)*p2*p.y();
+		J(1,0) = J(0,1);
+		J(1,1) = radial + dRadial*y2 + T(6)*p1*p.y() + T(2)*p2*p.x();
+		return J;
+	}
+	// distorted -> undistorted normalized coordinates by Newton iterations from p, stopped when a step
+	// moves both coordinates by less than 1e-12, or after 20 steps; the distortion must be
+	// invertible between p and the solution (positive Jacobian determinant)
+	HOST_DEVICE Vec2 Undistort(const Vec2& p) const {
+		using std::abs;
+		Vec2 u(p);
+		for (int iter = 0; iter < 20; ++iter) {
+			const Vec2 r(Distort(u) - p);
+			const Eigen::Matrix<T,2,2> J(Jacobian(u));
+			const T det(J(0,0)*J(1,1) - J(0,1)*J(1,0));
+			ASSERT(det > T(0));
+			const Vec2 step((J(1,1)*r.x() - J(0,1)*r.y()) / det, (J(0,0)*r.y() - J(1,0)*r.x()) / det);
+			u -= step;
+			if (abs(step.x()) < T(1e-12) && abs(step.y()) < T(1e-12))
+				break;
+		}
+		return u;
+	}
+};
+/*----------------------------------------------------------------*/
+
+
+// LidarCamera360 fork: the "spherical" model is an equidistant fisheye, not an equirectangular panorama.
+// The pixel is f*theta away from the center, theta the angle to +Z, on a square image whose width spans
+// FISHEYE_FOV radians, so (as the panorama it replaces) the size alone gives the intrinsics.
+// Directions beyond FISHEYE_FOV/2 project on that circle, which the images keep masked (no depth, no
+// texture): a lookup there finds nothing, so no caller needs to test the field of view.
+// Ray(x) is a unit vector, so the depth along it is |X|.
+// The (sin,cos) table arguments carry the normalized pixel: "sinLon" is u=(c-cx)/fx, "sinEl" v=(r-cy)/fy.
+#define FISHEYE_FOV 3.5
+template<typename T>
+struct Spherical {
+	typedef T Scalar;
+	typedef Eigen::Matrix<T,2,1> Vec2;
+	typedef Eigen::Matrix<T,3,1> Vec3;
+	typedef Eigen::Matrix<T,3,3> Mat3;
+
+	T fx, fy; // pixels per radian: size/FISHEYE_FOV
+	T cx, cy; // the optical axis: (size-1)/2
+
+	HOST_DEVICE static Spherical FromSize(int width, int height) {
+		ASSERT(width > 0 && height > 0);
+		return Spherical{
+			T(width) / T(FISHEYE_FOV), T(height) / T(FISHEYE_FOV),
+			T(width-1) / T(2), T(height-1) / T(2)};
+	}
+
+	// pixel -> normalized fisheye coordinates, of length theta
+	HOST_DEVICE Vec2 Angles(const Vec2& x) const {
+		ASSERT(fx > T(0) && fy > T(0));
+		return Vec2((x.x() - cx) / fx, (x.y() - cy) / fy);
+	}
+
+	HOST_DEVICE Vec3 Ray(const Vec2& x) const {
+		const Vec2 a(Angles(x));
+		return Ray(a.x(), T(0), a.y(), T(0));
+	}
+	HOST_DEVICE static Vec3 Ray(T u, T, T v, T) {
+		using std::cos; using std::sin; using std::sqrt;
+		const T t2(u*u + v*v);
+		if (t2 < T(1e-8))
+			return Vec3(u, v, T(1) - t2/T(2));
+		const T theta(sqrt(t2)), s(sin(theta)/theta);
+		return Vec3(u*s, v*s, cos(theta));
+	}
+	// x = f * theta/rho * (X.x,X.y) + c
+	HOST_DEVICE bool Project(const Vec3& X, Vec2& x) const {
+		using std::atan2; using std::sqrt;
+		const T r2(X.x()*X.x() + X.y()*X.y());
+		const T maxTheta(FISHEYE_FOV/2);
+		if (r2 <= T(1e-12)*X.z()*X.z()) {
+			if (X.z() > T(0)) {
+				x = Vec2(cx + fx*X.x()/X.z(), cy + fy*X.y()/X.z());
+				return true;
+			}
+			x = Vec2(cx + fx*maxTheta, cy);
+			return false;
+		}
+		const T rho(sqrt(r2));
+		T theta(atan2(rho, X.z()));
+		const bool visible(theta <= maxTheta);
+		if (!visible)
+			theta = maxTheta;
+		const T k(theta/rho);
+		x = Vec2(fx*k*X.x() + cx, fy*k*X.y() + cy);
+		return visible;
+	}
+	HOST_DEVICE FORCEINLINE bool ProjectFast(const Vec3& X, Vec2& x, T /*rho*/) const {
+		return ProjectFast(X, x);
+	}
+	HOST_DEVICE FORCEINLINE bool ProjectFast(const Vec3& X, Vec2& x) const {
+		using std::sqrt;
+		const T r2(X.x()*X.x() + X.y()*X.y());
+		const T maxTheta(FISHEYE_FOV/2);
+		if (r2 <= T(1e-12)*X.z()*X.z())
+			return Project(X, x);
+		const T rho(sqrt(r2));
+		T theta(FastAtan2(rho, X.z()));
+		const bool visible(theta <= maxTheta);
+		if (!visible)
+			theta = maxTheta;
+		const T k(theta/rho);
+		x = Vec2(fx*k*X.x() + cx, fy*k*X.y() + cy);
+		return visible;
+	}
+	HOST_DEVICE static T Depth(const Vec3& X) {
+		return X.norm();
+	}
+
+	// pixel offsets (dx,dy,1) around x -> rays, to first order
+	HOST_DEVICE Mat3 RayFrame(const Vec2& x) const {
+		const Vec2 a(Angles(x));
+		return RayFrame(a.x(), T(0), a.y(), T(0));
+	}
+	HOST_DEVICE Mat3 RayFrame(T u, T, T v, T) const {
+		using std::cos; using std::sin; using std::sqrt;
+		const T t2(u*u + v*v);
+		T s, g, c; // sin(theta)/theta, its derivative over theta, cos(theta)
+		if (t2 < T(1e-2)) {
+			s = T(1) - t2/T(6) + t2*t2/T(120);
+			g = T(-1)/T(3) + t2/T(30) - t2*t2/T(840);
+			c = T(1) - t2/T(2) + t2*t2/T(24);
+		} else {
+			const T theta(sqrt(t2));
+			s = sin(theta)/theta; c = cos(theta); g = (c - s)/t2;
+		}
+		Mat3 F;
+		F << (s + u*u*g)/fx, u*v*g/fy, u*s,
+		     u*v*g/fx, (s + v*v*g)/fy, v*s,
+		     -s*u/fx, -s*v/fy, c;
+		return F;
+	}
+	// rays near the given one -> homogeneous pixels: the gnomonic projection on the plane tangent to the
+	// sphere at the ray, scaled by the fisheye Jacobian there; exact at the ray and first order around it
+	HOST_DEVICE Mat3 PixelHomography(const Vec3& ray) const {
+		Vec2 x;
+		Project(ray, x);
+		return PixelHomography(ray, x);
+	}
+	HOST_DEVICE Mat3 PixelHomography(const Vec3& ray, const Vec2& x, T /*rho*/) const {
+		return PixelHomography(ray, x);
+	}
+	HOST_DEVICE Mat3 PixelHomography(const Vec3& ray, const Vec2& x) const {
+		using std::atan2; using std::sqrt;
+		// rows (up to the scale |ray|): fx*grad(theta*cos(phi)) + x.x*d, fy*grad(theta*sin(phi)) + x.y*d, d
+		const T rho(sqrt(ray.x()*ray.x() + ray.y()*ray.y())), n(ray.norm());
+		T cp(1), sp(0), k(1); // k = theta/sin(theta)
+		const T st(rho/n), ct(ray.z()/n);
+		if (st > T(1e-4)) {
+			cp = ray.x()/rho; sp = ray.y()/rho; k = atan2(rho, ray.z())/st;
+		}
+		const Vec3 eT(ct*cp, ct*sp, -st), eP(-sp, cp, T(0));
+		const Vec3 gx((eT*cp - eP*(k*sp))*(fx*n)), gy((eT*sp + eP*(k*cp))*(fy*n));
+		Mat3 P;
+		P << gx.x() + x.x()*ray.x(), gx.y() + x.x()*ray.y(), gx.z() + x.x()*ray.z(),
+		     gy.x() + x.y()*ray.x(), gy.y() + x.y()*ray.y(), gy.z() + x.y()*ray.z(),
+		     ray.x(), ray.y(), ray.z();
+		return P;
+	}
+};
