-		ASSERT(state == Base::PENDING || state == Base::LOCKED);
-		if (state == Base::PENDING && flag.compare_exchange_weak(state, Base::LOCKED, std::memory_order_acquire))
-			return true;
-		state = flag.load(std::memory_order_acquire);
